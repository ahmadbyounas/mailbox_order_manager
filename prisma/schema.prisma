generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Provider {
  GOOGLE
  MICROSOFT
}

enum OrderStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
}

enum MailboxStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  role      Role       @default(CUSTOMER)
  orders    Order[]
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("users")
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain         String
  provider       Provider
  mailboxCount   Int
  status         OrderStatus @default(PENDING)
  idempotencyKey String?     @unique
  mailboxes      Mailbox[]
  auditLogs      AuditLog[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@map("orders")
}

model Mailbox {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  email        String
  status       MailboxStatus @default(PENDING)
  externalId   String?
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orderId])
  @@map("mailboxes")
}

model AuditLog {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  changedById   String?
  changedBy     User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)
  triggerSource String
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("audit_logs")
}
